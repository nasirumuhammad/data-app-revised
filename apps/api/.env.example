NODE_ENV=development
PORT=5000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=data_app
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Required, at least 32 characters each, and different from each other.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Also keys the HMAC that hashes stored refresh tokens.
JWT_REFRESH_SECRET=

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=12
